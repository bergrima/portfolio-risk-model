# Virtual environment
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Build artifacts
build/
dist/
*.egg-info/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type-checker and linter caches
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local data
data/raw/*
data/interim/*
data/processed/*

# Keep data directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Logs
*.log
logs/

# IDE/editor files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db